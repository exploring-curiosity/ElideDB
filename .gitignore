# ---- data: never in git ----------------------------------------------------
# raw captures (GBs, private)
data/
Data/
# generated databases: rebuild with `elidedb` ingest or python/elidedb/migrate.py
lake/
store/
store_oxford/
stores/

# ---- evaluation ground truth: derived from a dataset, not part of the DB ---
# eval/ holds label files and graded verdicts used ONLY by benchmark scripts.
# Deliberately outside the store so the query path cannot reach them.
eval/

# ---- model weights and caches (downloaded on first use) --------------------
models/
FastSAM-*.pt
*.ckpt
.cache/
hf_cache/

# ---- deploy build artifacts (regenerated by scripts) -----------------------
# demo store: scripts/build_demo_store.py
deploy/demo/
# HF Space staging: deploy/stage_space.py
deploy/space/

# ---- separate research project, not part of the database product ----------
# FDNN_BrainModel is the neuron/pruning research this repo's context tower
# borrows from (see docs/CONTEXT.md). It carries its own 426 MB virtualenv.
FDNN_BrainModel/

# ---- python environment / build artifacts ----------------------------------
myenv/
venv/
.venv/
build/
*.o
*.a
*.so
*.dylib
__pycache__/
*.pyc
*.egg-info/
dist/
.eggs/
*.whl
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- run/scratch output ----------------------------------------------------
bench_results.jsonl
notebooks/.ipynb_checkpoints/
.ipynb_checkpoints/
*.log
nohup.out
*.tmp

# ---- secrets and local-only config -----------------------------------------
.env
.env.*
.claude/settings.local.json

# ---- OS / editor -----------------------------------------------------------
.DS_Store
.vscode/
.idea/

# ---- internal working notes (not part of the product) ----------------------
CLAUDE.md
docs/memory/
docs/logs/

# ---- stale experiment cache: LanguageBind weights (never in git) -----------
.cache_lb/

# Model weights: re-downloadable artifacts, never in git. 62 MB of these
# were committed because ultralytics downloads into the CWD by default.
models/weights/
# Benchmark outputs are results, not source
bench/*.json
bench/*.jsonl
scratch_*/

# MuJoCo model library: cloned, not ours
mujoco_menagerie/

# ---- Desk QbE derived media (thumbnails, preview clips, query uploads) --
# regenerated on demand from the sources; stores/ is already ignored but
# this is here so the intent survives a change to that line.
stores/_deskcache/
native/verdicts.jsonl

